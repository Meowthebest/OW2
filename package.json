{
  "name": "ow2-hero-selector",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/test-logic.mjs && node scripts/test-patches.mjs && node scripts/test-players.mjs && node --test worker/test/worker.test.mjs && node --test timer/test/timer.test.mjs && npm run build && node scripts/test-ui.mjs",
    "test:logic": "node scripts/test-logic.mjs",
    "test:patches": "node scripts/test-patches.mjs",
    "test:players": "node scripts/test-players.mjs",
    "test:worker": "node --test worker/test/worker.test.mjs",
    "test:timer": "node --test timer/test/timer.test.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "check:roster": "node scripts/check-roster.mjs",
    "sync:patches": "node scripts/patches/cli.mjs sync",
    "verify:patches": "node scripts/patches/cli.mjs verify",
    "check:patches": "node scripts/patches/cli.mjs check"
  },
  "dependencies": {
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.21.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.38",
    "typescript": "^5.5.3",
    "vite": "^5.3.1"
  }
}
