 "notes": [
  {
   "heroId": "dmon",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "The barrier should cost more to use and telegraph better, while her burst and the health she recovers through Overstrike both come down.",
   "summary": "Power Barrier recovers more slowly and has a minimum deploy time, Propulsors lose impact damage, and Overstrike heals less."
  },
  {
   "heroId": "junker-queen",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "Aimed at moments when she cannot apply Wounds to heal herself. More health helps her engage, and Carnage is available more often.",
   "summary": "More base health in 5v5 and 6v6, a shorter Carnage cooldown, and new tracking UI for Commanding Shout."
  },
  {
   "heroId": "mauga",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "His win rate had dropped too far after earlier changes. Armor returns for survivability, and burn pays off without leaning harder on enemy tanks.",
   "summary": "More base armor and stronger burn damage over time."
  },
  {
   "heroId": "ramattra",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "Ranged pressure lasts longer outside Nemesis Form.",
   "summary": "More Void Accelerator ammo."
  },
  {
   "heroId": "winston",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "A shorter Barrier Projector cooldown raised this perk's uptime, so its healing is trimmed to match.",
   "summary": "Revitalizing Barrier heals less per second."
  },
  {
   "heroId": "anran",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "Inferno Rush now does less in a single use. Extra fan damage helps at range and with setting up ignites, and a faster cast makes the ultimate easier to use reactively.",
   "summary": "Stronger fans and a quicker Vermillion Ascent, but Inferno Rush loses its knockback and repeat hits."
  },
  {
   "heroId": "echo",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "The perk becomes worth more, since Echo can skip a reload after using it.",
   "summary": "Aerial Munitions now refills ammo too."
  },
  {
   "heroId": "emre",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "A faster detonation makes the grenade more dependable for finishing targets. The reticle items only concern customization of the default reticle.",
   "summary": "Cyber Frag detonates sooner. Default reticle settings and previews also changed, with no change to the in-game reticle."
  },
  {
   "heroId": "genji",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "His recent kill pressure prompted this. Deflect now protects him for less time and asks for better timing.",
   "summary": "Shorter Deflect."
  },
  {
   "heroId": "hanzo",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "A health pack held by Hanzo or Sombra now stays with that hero.",
   "summary": "Sonic Disruption can no longer take over Sombra's hacked health packs."
  },
  {
   "heroId": "reaper",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "Offsets the effectiveness he lost to recent hitbox and projectile size changes.",
   "summary": "More base health."
  },
  {
   "heroId": "shion",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "Execution should be reliable up close without a full charge, and the ultimate should allow quicker repositioning between volleys.",
   "summary": "Tighter starting spread on Execution and faster Satsuriku Spree volleys."
  },
  {
   "heroId": "vendetta",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "She had become too deadly, so her combos open more slowly, her leap is easier to follow, and Raging Storm pushes targets around less.",
   "summary": "Slower Palatine Fang combos and leap, and less knockback from Whirlwind Dash with Raging Storm."
  },
  {
   "heroId": "ana",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "An earlier self-healing increase had also raised the grenade's burst. Damage and healing are now separate, which keeps the self-healing.",
   "summary": "Biotic Grenade explosion hits for less."
  },
  {
   "heroId": "baptiste",
   "group": "standard",
   "hasDeveloperComment": false,
   "devIntent": null,
   "summary": "New tracking UI for Regenerative Burst, with no balance values changed."
  },
  {
   "heroId": "brigitte",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "Instant healing had not done enough for her sustain in fights, so it now heals more, more often, during long engagements.",
   "summary": "Inspire triggers more often and heals more instantly."
  },
  {
   "heroId": "doctrine",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "His healing was high for the utility he also brings. Output and burst come down, and longer cooldowns ask for more deliberate use.",
   "summary": "Five nerfs: slower primary fire, lower Infused damage and healing, and longer Shrouded Momentum and Infuse cooldowns."
  },
  {
   "heroId": "illari",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "Recent projectile size changes had reduced her damage. Faster charging raises output, and a stronger Pylon supports defensive setups.",
   "summary": "Faster Solar Rifle charge and more healing per Healing Pylon projectile."
  },
  {
   "heroId": "jetpack-cat",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "Survivability comes down while mobility stays her strength. She repositions faster but can use Frenetic Flight less often.",
   "summary": "Less base health and slower fuel regeneration, against faster Frenetic Flight acceleration."
  },
  {
   "heroId": "sombra",
   "group": "standard",
   "hasDeveloperComment": true,
   "devIntent": "A shorter Hotfix makes target choice matter more, and lower Weaken gives enemies room to respond. EMP keeps its value as an ultimate after the health pack changes with Hanzo.",
   "summary": "Shorter Hotfix and weaker Cyberspace Weaken, plus a situational EMP gain on health packs."
  },
  {
   "heroId": "winston",
   "group": "stadium",
   "hasDeveloperComment": false,
   "devIntent": null,
   "summary": "Tesla Field deals less damage."
  },
  {
   "heroId": "cassidy",
   "group": "stadium",
   "hasDeveloperComment": false,
   "devIntent": null,
   "summary": "Barrage Blastin' has a smaller damage penalty, and Silver Bullet hits harder."
  },
  {
   "heroId": "genji",
   "group": "stadium",
   "hasDeveloperComment": false,
   "devIntent": null,
   "summary": "Wyrm's Maw gives more Swift Strike damage per stack."
  },
  {
   "heroId": "sojourn",
   "group": "stadium",
   "hasDeveloperComment": false,
   "devIntent": null,
   "summary": "Hard Stuck has a smaller damage penalty."
  },
  {
   "heroId": "vendetta",
   "group": "stadium",
   "hasDeveloperComment": false,
   "devIntent": null,
   "summary": "Apex Bloodlust has less lifesteal, and Rampant Onslaught needs more eliminations per stack."
  },
  {
   "heroId": "mizuki",
   "group": "standard",
   "hasDeveloperComment": false,
   "devIntent": null,
   "summary": "Bug fix only, with no balance values changed."
  },
  {
   "heroId": "wrecking-ball",
   "group": "standard",
   "hasDeveloperComment": false,
   "devIntent": null,
   "summary": "Bug fix only, with no balance values changed."
  }
 ],
